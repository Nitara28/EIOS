# EIOS Backend Environment Configuration Template
# Set environment variables for production deployment

# Application Settings
ENVIRONMENT="production" # Options: development, staging, production
PROJECT_NAME="EIOS AI COO"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_32_byte_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default: sqlite:///./eios.db
# Production PostgreSQL example: postgresql://username:password@hostname:5432/eios_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/eios_db"

# CORS & Frontend URL Configuration
FRONTEND_URL="https://your-production-frontend.com"
CORS_ORIGINS="https://your-production-frontend.com,http://localhost:3000"

# Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# Google Gmail OAuth Connector
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://your-backend-domain.com/api/v1/connectors/gmail/callback"

# WhatsApp Business Cloud API Connector
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_APP_ID="your_whatsapp_app_id"
WHATSAPP_APP_SECRET="your_whatsapp_app_secret"
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_API_VERSION="v18.0"
